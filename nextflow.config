manifest {
    name        = 'watkins/pbgatk-nextflow'
    version     = '0.1.0'
    description = 'Watkins Parabricks + bcftools workflow in Nextflow DSL2'
}

params {
    samplesheet  = null
    ref          = null
    outdir       = 'results'
    contig_subset       = ''
    merge_chunk_size    = 250
    run_flagstat        = false

    container_parabricks = 'docker://nvcr.io/nvidia/clara/clara-parabricks:4.3.2-1'
    container_bwa        = 'docker://quay.io/biocontainers/bwa:0.7.17--h7132678_9'
    container_bcftools   = 'docker://quay.io/biocontainers/bcftools:1.21--h8b25389_0'
    container_samtools   = 'docker://quay.io/biocontainers/samtools:1.18--h50ea8bc_1'

    call_htvc_threads    = 32
    call_default_gpus    = 1

    local_container_dir  = "${projectDir}/containers"

    slurm_cpu_queue      = 'jic-compute,nbi-compute'
    slurm_gpu_queue      = 'jic-gpu'
    slurm_gpu_type       = 'a100'

    // FIX: request 1 GPU per job (not 2) so two jobs can share a 2-GPU node.
    slurm_gpu_request    = 1

    slurm_gpu_localscratch_gb  = 3500
    slurm_merge_localscratch_gb = 1500

    cpu_small_cpus   = 4
    cpu_small_memory = '16 GB'
    cpu_small_time   = '2h'

    cpu_medium_cpus   = 8
    cpu_medium_memory = '32 GB'
    cpu_medium_time   = '8h'

    cpu_merge_cpus   = 16
    cpu_merge_memory = '250 GB'
    cpu_merge_time   = '24h'

    gpu_call_cpus   = 16
    gpu_call_memory = '475 GB'
    gpu_call_time   = '36h'
}

process {

    shell        = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    maxForks  = 10
    queueSize = 50

    withName: PBGATK_GERMLINE {
        container      = { params.container_parabricks }
        containerOptions = '--nv'
        cpus   = 16
        memory = '475 GB'
        time   = params.gpu_call_time
        queue  = params.slurm_gpu_queue

        // FIX: set to 2 to match the number of GPUs on each node.
        // Previously set to 4, which could schedule 4 jobs onto a 2-GPU node
        // and cause them to fight over 3576 GB SSD scratch (4 × 1500 = 6000 GB).
        maxForks = 2

        clusterOptions = {
            "--gres=ssd,gpu:${params.slurm_gpu_type}:${params.slurm_gpu_request}" +
            " --localscratch=ssd:${params.slurm_gpu_localscratch_gb}"
        }
    }

    // FIX: process name was BWA_INDEX but the module defines it as BUILD_BWA_INDEX
    // (a sub-workflow). The actual processes inside are BWA_INDEX and SAMTOOLS_FAIDX,
    // which is what withName must target.
    withName: BWA_INDEX {
        container = { params.container_bwa }
        cpus   = params.cpu_medium_cpus
        memory = params.cpu_medium_memory
        time   = params.cpu_medium_time
        clusterOptions = '--gres=ssd --localscratch=ssd:10'
    }

    withName: SAMTOOLS_FAIDX {
        container = { params.container_samtools }
        cpus   = params.cpu_medium_cpus
        memory = params.cpu_medium_memory
        time   = params.cpu_medium_time
        clusterOptions = '--gres=ssd --localscratch=ssd:10'
    }

    withName: COMPRESS_AND_INDEX_VCF {
        container = { params.container_bcftools }
        cpus   = params.cpu_medium_cpus
        memory = params.cpu_medium_memory
        time   = params.cpu_medium_time
        clusterOptions = '--gres=ssd --localscratch=ssd:10'
    }

    withName: GET_CONTIGS {
        container = { params.container_bcftools }
        cpus   = params.cpu_small_cpus
        memory = params.cpu_small_memory
        time   = params.cpu_small_time
        clusterOptions = '--gres=ssd --localscratch=ssd:10'
    }

    withName: EXTRACT_CONTIG_SAMPLE {
        container = { params.container_bcftools }
        cpus   = params.cpu_medium_cpus
        memory = params.cpu_medium_memory
        time   = params.cpu_medium_time
        clusterOptions = '--gres=ssd --localscratch=ssd:10'
    }

    withName: MERGE_CONTIG_CHUNK {
        container = { params.container_bcftools }
        cpus   = params.cpu_merge_cpus
        memory = params.cpu_merge_memory
        time   = params.cpu_merge_time
    }

    withName: MERGE_CONTIG_FINAL {
        container = { params.container_bcftools }
        cpus   = params.cpu_merge_cpus
        memory = params.cpu_merge_memory
        time   = params.cpu_merge_time
    }

    withName: CONCAT_ALL_CONTIGS {
        container = { params.container_bcftools }
        cpus   = params.cpu_merge_cpus
        memory = params.cpu_merge_memory
        time   = params.cpu_merge_time
    }

    withName: FLAGSTAT_CRAM {
        container = { params.container_samtools }
        cpus   = params.cpu_small_cpus
        memory = params.cpu_small_memory
        time   = params.cpu_small_time
    }

    withName: PRECHECK_GPU_PROFILE_COUNTS {
        container = { params.container_bcftools }
        cpus   = params.cpu_small_cpus
        memory = params.cpu_small_memory
        time   = params.cpu_small_time
        clusterOptions = '--gres=ssd --localscratch=ssd:10'
    }
}

profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process {
            executor = 'slurm'
            queue    = params.slurm_cpu_queue

            withLabel: cpu_merge {
                clusterOptions = "--gres=ssd --localscratch=ssd:${params.slurm_merge_localscratch_gb}"
            }

            withLabel: gpu_call {
                queue = params.slurm_gpu_queue
            }
        }
    }
    singularity {
        singularity.enabled      = true
        singularity.autoMounts   = true
        singularity.envWhitelist = 'SLURM_LOCAL_SCRATCH,SLURM_TMPDIR,TMPDIR'
        singularity.cacheDir     = "${projectDir}/.singularity"
        // ADD THIS: Point singularity runtime tmp space to the local node NVMe/SSD
        singularity.runOptions   = '-B $SLURM_LOCAL_SCRATCH:/tmp -B $SLURM_LOCAL_SCRATCH:/var/tmp'
        docker.enabled           = false
    }

    singularity_offline {
        singularity.enabled      = true
        singularity.autoMounts   = true
        singularity.envWhitelist = 'SLURM_LOCAL_SCRATCH,SLURM_TMPDIR,TMPDIR'
        singularity.cacheDir     = "${projectDir}/.singularity"
        // ADD THIS: Same local SSD mapping for offline runs
        singularity.runOptions   = '-B $SLURM_LOCAL_SCRATCH:/tmp -B $SLURM_LOCAL_SCRATCH:/var/tmp'
        docker.enabled           = false

        params.container_parabricks = "${params.local_container_dir}/parabricks-4.3.2-1.sif"
        params.container_bwa        = "${params.local_container_dir}/bwa-0.7.17.sif"
        params.container_bcftools   = "${params.local_container_dir}/bcftools-1.21.sif"
        params.container_samtools   = "${params.local_container_dir}/samtools-1.18.sif"
    }


    docker {
        docker.enabled    = true
        singularity.enabled = false

        params.container_parabricks = 'nvcr.io/nvidia/clara/clara-parabricks:4.3.2-1'
        params.container_bwa        = 'quay.io/biocontainers/bwa:0.7.17--h7132678_9'
        params.container_bcftools   = 'quay.io/biocontainers/bcftools:1.21--h8b25389_0'
        params.container_samtools   = 'quay.io/biocontainers/samtools:1.18--h50ea8bc_1'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.txt"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/dag.html"
}
